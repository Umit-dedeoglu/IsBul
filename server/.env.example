# Sunucu
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=isbul_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Development
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
# Production (Render)
GOOGLE_CALLBACK_URL=https://isbul-backend.onrender.com/api/v1/auth/google/callback

# GROQ AI (Chatbot)
GROQ_API_KEY=your_groq_api_key_here

# Frontend URL (CORS ve OAuth redirect için)
# Development
# FRONTEND_URL=http://localhost:4000
# Production
FRONTEND_URL=https://isbul.online

# Veritabanı
DB_PATH=./data/isbul.db


# PostgreSQL (Production - Supabase)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
